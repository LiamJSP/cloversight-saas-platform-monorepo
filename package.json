{
  "name": "cloversight-saas",
  "version": "0.5.22",
  "private": true,
  "description": "Website monitoring SaaS local platform, static portals, AWS CloudFormation, billing safeguards, and Chrome target picker.",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "@picocss/pico": "2.1.1",
    "d3-geo": "3.1.1",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "three": "0.186.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "bash scripts/platform.sh dev",
    "dev:debug": "LOG_LEVEL=debug DEBUG_INTERNALS=true node --inspect src/server.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 --test-reporter=spec tests/browser/*.test.mjs",
    "test:browser:docker": "node scripts/run-browser-tests-docker.mjs local",
    "test:staging:smoke": "node scripts/staging-smoke.mjs",
    "test:staging:functional": "node scripts/staging-functional.mjs",
    "test:staging:regional": "node scripts/staging-regional-check.mjs",
    "test:staging:payment-boundary": "node scripts/staging-payment-boundary.mjs",
    "test:staging:ci": "node scripts/staging-ci-gate.mjs",
    "test:staging:tokens": "node scripts/staging-ci-tokens.mjs",
    "test:staging:browser": "node --test --test-reporter=spec tests/staging-browser/*.test.mjs",
    "test:staging:browser:docker": "node scripts/run-browser-tests-docker.mjs staging",
    "test:load:plan": "node scripts/staging-load-probe.mjs --dry-run",
    "test:load": "node scripts/staging-load-probe.mjs",
    "typecheck": "node scripts/syntax-check.mjs",
    "verify": "node scripts/verify.mjs",
    "doctor": "node scripts/doctor.mjs",
    "browser:install": "node scripts/install-local-browser.mjs",
    "browser:docker:check": "node scripts/check-browser-docker.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "package:release": "node scripts/package-release.mjs",
    "iac:validate": "node scripts/validate-iac.mjs",
    "local:check": "node scripts/run-local-check.mjs",
    "deploy:settings": "node scripts/deployment-settings.mjs show",
    "deploy:validate": "node scripts/deployment-settings.mjs validate",
    "aws:bootstrap": "bash scripts/platform.sh bootstrap",
    "aws:build-worker": "bash infra/scripts/build-worker-image.sh",
    "aws:deploy": "bash infra/scripts/deploy.sh",
    "aws:deploy-regional": "bash infra/scripts/deploy-regional-captures.sh",
    "aws:push-secrets": "bash infra/scripts/push-secrets.sh",
    "aws:deploy-web": "bash infra/scripts/deploy-web.sh",
    "aws:activate-ses": "bash infra/scripts/activate-ses-receiving.sh",
    "aws:update-allowlist": "bash infra/scripts/update-staging-allowlist.sh",
    "aws:stack-events": "bash infra/scripts/stack-events.sh",
    "aws:delete-dev": "bash infra/scripts/delete-dev-stack.sh",
    "aws:audit": "bash infra/scripts/post-deploy-audit.sh",
    "aws:collect-audit": "bash infra/scripts/collect-cloud-audit.sh",
    "aws:push-stripe-secret": "bash infra/scripts/push-stripe-secret.sh",
    "build:regional-globe": "node scripts/build-regional-globe.mjs",
    "docs:reference": "python3 scripts/generate-doc-reference.py",
    "docs:charts": "python3 scripts/generate-architecture.py",
    "docs:js": "jsdoc -c jsdoc.json",
    "docs:generate": "npm run docs:reference && npm run docs:charts && npm run docs:js",
    "docs:site": "mkdocs build -f mkdocs.yml",
    "dev:server": "node src/server.mjs",
    "deploy": "bash scripts/platform.sh deploy",
    "deps:lock": "node scripts/lock-dependencies.mjs",
    "test:release": "npm run verify && npm run test:browser:docker",
    "setup": "node scripts/ensure-dependencies.mjs",
    "deps:check": "node scripts/dependency-locks.mjs",
    "capacity:plan": "node scripts/capacity-plan.mjs",
    "usage:reconcile": "node scripts/reconcile-watcher-usage.mjs",
    "iac:schema": "node scripts/validate-cfn-schema.mjs",
    "build:public": "astro build --root apps/public",
    "predev:server": "npm run build:public",
    "predev:debug": "npm run build:public",
    "pretest:browser": "npm run build:public",
    "pretest": "npm run build:public",
    "acceptance:scheduled": "node scripts/scheduled-acceptance.mjs"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@aws-sdk/client-dynamodb": "3.1141.0",
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/client-sqs": "3.1146.0",
    "@aws-sdk/lib-dynamodb": "3.1141.0",
    "astro": "7.4.13",
    "esbuild": "0.28.2",
    "jsdoc": "4.0.5",
    "sass": "1.108.2"
  }
}

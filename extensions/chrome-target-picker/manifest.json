{
  "manifest_version": 3,
  "name": "CLOVERSIGHT Target Picker",
  "version": "0.3.1",
  "description": "Select dynamic DOM regions that CLOVERSIGHT should ignore during page checks.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "CLOVERSIGHT Target Picker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

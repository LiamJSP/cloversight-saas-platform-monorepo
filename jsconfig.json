{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*.mjs",
    "scripts/**/*.mjs",
    "tests/**/*.mjs"
  ],
  "exclude": [
    "dist",
    ".local",
    "src/aws/**/*.mjs"
  ]
}

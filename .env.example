# CLOVERSIGHT 0.5.20 configuration template
# Copy to .env, keep mode 0600, and never commit real credentials.

# Local runtime
APP_ENV=local
HOST=127.0.0.1
PORT=4010
LOG_LEVEL=info
DEBUG_INTERNALS=false
LOCAL_STATE_PATH=.local/state.json
LOCAL_ASSET_PATH=.local/assets
LOCAL_OUTBOX_PATH=.local/outbox
LOCAL_CUSTOMER_ID=acct_demo
LOCAL_CUSTOMER_EMAIL=demo@example.com
LOCAL_STEWARD_ID=staff_demo
CHROME_EXECUTABLE_PATH=/usr/bin/chromium
CAPTURE_WIDTH=1440
CAPTURE_HEIGHT=900
CAPTURE_TIMEOUT_MS=30000
MAX_PAGE_BYTES=10000000
ALLOWED_PRIVATE_TARGETS=false
RESPONSE_BASE_URL=http://127.0.0.1:4010

# Primary AWS deployment
STAGE=staging
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
AWS_PROFILE=saas-admin
STACK_NAME=webwatch-staging
BOOTSTRAP_STACK_NAME=webwatch-deployment-bootstrap
AWS_DEPLOYMENT_PRINCIPAL_ARN=
AWS_DEPLOYMENT_ROLE_ARN=
AWS_CLOUDFORMATION_EXECUTION_ROLE_ARN=
AWS_ROLE_SESSION_SECONDS=3600
ARTIFACT_BUCKET=
WORKER_ECR_REPOSITORY=webwatch-browser-worker
WORKER_IMAGE_URI=
REGIONAL_CHECK_REGIONS=us-east-1,us-east-2,us-west-2,ca-central-1,eu-west-1

# Route 53, ACM, Cognito, and staging access
DNS_PROVIDER=route53
BASE_DOMAIN=example.com
ROUTE53_HOSTED_ZONE_ID=
CLOUDFRONT_CERTIFICATE_ARN=
STAGING_IP_ALLOWLIST_FILE=config/staging-ip-allowlist.txt
# Any-IP ChatGPT header exception at CloudFront and Cognito; staging only.
# These header patterns are spoofable. Cognito and route authorization still apply.
STAGING_CHATGPT_BROWSER_ENABLED=true
COGNITO_CUSTOMER_DOMAIN_PREFIX=
COGNITO_CUSTOMER_DOMAIN_MODE=prefix
COGNITO_CUSTOMER_CERTIFICATE_ARN=
COGNITO_STEWARD_DOMAIN_PREFIX=
COGNITO_CUSTOMER_MFA=OFF
# Required ON in production; staging keeps the requested exception.
COGNITO_STEWARD_MFA=OFF
STEWARD_EMAIL=
# Immutable Cognito sub of the owner user in this stage
STEWARD_OWNER_SUB=

# Cost and lifecycle controls
MONTHLY_BUDGET_USD=25
# Existing monthly budget remains the WHOLE ACCOUNT backstop.
# Optional additional Application=WebWatch AND Stage=<stage> tagged-cost budget.
# Activate both allocation tags in AWS Billing before setting these true.
SCOPED_BUDGET_ENABLED=false
COST_ALLOCATION_TAGS_ACTIVATED=false
SCOPED_MONTHLY_BUDGET_USD=25
RESOURCE_OWNER=CLOVERSIGHT
RESERVED_CHECK_CONCURRENCY=2
WORKER_RESERVED_CONCURRENCY=4
# On-demand ceilings, not provisioned concurrency; no idle browser compute.
CAPTURE_RESERVED_CONCURRENCY=64
# Blank inherits CAPTURE_RESERVED_CONCURRENCY for each secondary Region.
REGIONAL_CAPTURE_CONCURRENCY=
DISPATCH_BATCH_SIZE=500
# Soft queue admission caps; tune against measured processing tails and slots.
CAPTURE_QUEUE_MAX_OUTSTANDING=256
CAPTURE_QUEUE_HEALTH_CACHE_SECONDS=10
CAPTURE_QUEUE_DEFERRAL_SECONDS=60
CHECK_QUEUE_MAX_OUTSTANDING=500
SNAPSHOT_RETENTION_DAYS=90
ACCOUNT_CLOSURE_GRACE_DAYS=30
ADMIN_IDLE_TIMEOUT_MINUTES=30
PRODUCTION_DEPLOY_APPROVED=false
DELETE_STAGING_APPROVED=false
ORIGIN_VERIFY_REVISION=1

# Billing. Use Stripe test values in staging and live values only in production.
BILLING_PROVIDER=local
BILLING_CURRENCY=USD
PRICE_INTEGRITY_SECRET=
# Blank defaults to live in prod, test in staging/beta. Explicit test permits
# a production-domain sandbox trial; use the matching key, Prices and webhook.
STRIPE_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_PRICE_FREE=
STRIPE_PRICE_ESSENTIALS=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_SCALE=
STRIPE_REQUEST_3DS=automatic

# Email and optional SMS
EMAIL_PROVIDER=local
SES_REGION=us-east-1
SES_FROM_ADDRESS=
SES_REPLY_DOMAIN=
SES_RECEIPT_RULE_SET_NAME=
REPLACE_ACTIVE_SES_RULE_SET=false
STAFF_ACTION_EMAIL=
TECHNICAL_ALERTS_ENABLED=false
TECHNICAL_ALERT_EMAIL=
# Independent AWS/SNS and AWS Budgets destinations; explicit in production.
# Confirm the SNS email subscription in EVERY deployed Region before customer work.
# Staging/beta fall back to TECHNICAL_ALERT_EMAIL only when technical alerts are enabled.
OPS_ALERT_EMAIL=
BUDGET_ALERT_EMAIL=
SMS_PROVIDER=local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_ALLOWED_COUNTRIES=US,CA

# Optional reviewed exact HTTPS custom Stripe payment origins, comma-separated.
# Built-in checkout.stripe.com and invoice.stripe.com are always allowed.
STRIPE_PAYMENT_ORIGINS=
